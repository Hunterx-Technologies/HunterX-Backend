PORT=5000
NODE_ENV=development

# Local PostgreSQL
# For local dev, keep using your existing local Postgres connection.
# In Railway, this is auto-injected via the linked ${{Postgres.DATABASE_URL}}
# variable (which resolves to Postgres's internal Railway hostname, only
# reachable from inside Railway's network) — do not hardcode it in Railway's
# dashboard, and don't try to point local dev at that internal hostname.
DATABASE_URL=

# JWT — generate two strong random secrets (min 32 chars each)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Google OAuth — create OAuth 2.0 Client IDs in Google Cloud Console
# (APIs & Services → Credentials) for each platform the app ships on.
# The backend accepts an ID token issued for ANY of these client IDs —
# fill in only the ones you've created; leave the rest blank.
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=

# Apple Sign-In
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Gmail SMTP Configuration
GMAIL_USER=
GMAIL_PASS=
EMAIL_FROM="HunterX <support.hunterx@gmail.com>"

# App URL — used in password reset link (use exp:// scheme for Expo Go deep linking)
# APP_URL=exp://192.168.1.9:8081/--
APP_URL=http://192.168.1.9:8081

# Hunter ID prefix
HUNTER_ID_PREFIX=HUN

# Redis — live index for the Leaderboard feature (global sorted
# set + display cache). Without this set, the leaderboard still works
# but every request takes the Postgres fallback path (slower at scale,
# and `me.rank` is always null for global).
# For local dev, point at a local Redis (e.g. `docker run -p 6379:6379 redis`).
# In Railway, add a Redis plugin to BOTH the UAT and production
# environments and set this as a reference variable to it
# (${{Redis.REDIS_URL}}) rather than hardcoding a URL — same pattern as
# DATABASE_URL above.
REDIS_URL=

# Expo push notifications — optional. Only needed if "Enhanced push
# security" is turned on for the project at expo.dev (Access tokens page).
# APNs/FCM credentials themselves live in EAS, not here.
EXPO_ACCESS_TOKEN=

# Cloudinary — media storage. Create a free account at cloudinary.com;
# these three values are on your Dashboard home page.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Discord webhook — team-facing notifications for the "Send Feedback"
# screen only; nothing about this is ever exposed to the app or its users.
# Create one per environment (Server Settings → Integrations → Webhooks) and
# use a SEPARATE webhook/channel for UAT vs production in Railway so test
# feedback never lands in the same channel as real user feedback.
DISCORD_WEBHOOK_URL=

# Default admin — created on boot only if no user with this email exists.
# Leave both blank to skip. Password: 12+ chars with an uppercase letter,
# a number and a special character. Set per environment in Railway; never
# commit real values.
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
